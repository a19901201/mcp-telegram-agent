# Telegram Bot Token：向 @BotFather 建立機器人後取得
# （選填）未設定時伺服器仍可正常啟動，
# 僅在實際呼叫需要權杖的工具時回報缺少權杖錯誤。
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 預設目標 Chat ID：發送任一訊息給 @userinfobot 取得
# （選填）未設定時仍可正常啟動，
# 發送工具必須自行傳入 chat_id 參數。
# TELEGRAM_DEFAULT_CHAT_ID=123456789

# 互動接收白名單（Chat ID，逗號分隔，如 123456789,-1001234567890）
# （選填）未設定時 get_updates / wait_for_reply 會回傳設定提示，
# 需加入後重啟 MCP 伺服器才會開始接收使用者回覆。
# 僅設定此名單時，僅依 chat_id 過濾。
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# 互動接收白名單（User ID，逗號分隔，如 123456789）
# （選填）已設定的白名單中，任一命中即放行；僅設定其中一份時，
# 僅依該份名單過濾。
# poll_answer 事件沒有 chat_id，無法與 chat 白名單比對，
# 只能靠 user 白名單過濾。
# TELEGRAM_ALLOWED_USER_IDS=123456789

# 互動狀態目錄：存放 getUpdates offset 持久化檔案
# （選填）未設定時預設寫入系統暫存目錄下的 mcp-telegram-agent 子目錄。
# TELEGRAM_STATE_DIR=/tmp/mcp-telegram-agent
