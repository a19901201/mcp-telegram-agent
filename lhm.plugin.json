          "chat_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chat Id"
          }
        },
        "type": "object",
        "title": "send_chat_actionArguments"
      }
    },
