{
  "identifier": "a19901201-mcp-telegram-agent",
  "name": "MCP Telegram Agent",
  "version": "0.1.8",
  "description": "Full Telegram Bot control for AI agents via pure Bot API: zero login risk, one Bot Token.",
  "author": "a19901201",
  "authorUrl": "https://github.com/a19901201",
  "homepage": "https://github.com/a19901201/mcp-telegram-agent",
  "category": "developer",
  "tags": [
    "telegram",
    "bot",
    "messaging",
    "communication"
  ],
  "icon": "✈️",
  "tools": [
    {
      "name": "send_text_message",
      "description": "Send text messages with Markdown/HTML formatting, silent mode, protection, inline buttons, or custom reply keyboards.\n\n發送文字訊息。支援 Markdown 與 HTML 格式解析、靜音推播、內容保護、行內按鈕與底部鍵盤。\n",
      "inputSchema": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          },
          "chat_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Chat Id"
          },
          "parse_mode": {
            "default": "Markdown",
            "enum": [
              "Markdown",
              "HTML"
            ],
            "title": "Parse Mode",
            "type": "string"
          },
          "disable_notification": {
            "default": false,
            "title": "Disable Notification",
            "type": "boolean"
          },
          "protect_content": {
            "default": false,
            "title": "Protect Content",
            "type": "boolean"
          },
          "inline_buttons": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "$ref": "#/$defs/InlineButton"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Inline Buttons"
          },
          "reply_keyboard": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reply Keyboard"
          },
          "one_time_keyboard": {
            "default": true,
            "title": "One Time Keyboard",
            "type": "boolean"
          },
          "remove_keyboard": {
            "default": false,
            "title": "Remove Keyboard",
            "type": "boolean"
          }
        },
        "required": [
          "text"
        ],
        "type": "object",
        "$defs": {
          "InlineButton": {
            "properties": {
              "text": {
                "description": "Button label text / 按鈕顯示文字",
                "title": "Text",
                "type": "string"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "URL opened when clicked / 點擊後開啟的外部網址",
                "title": "Url"
              },
              "callback_data": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Data sent back to the bot / 點擊後回傳機器人的資料字串",
                "title": "Callback Data"
              }
            },
            "required": [
              "text"
            ],
            "title": "InlineButton",
            "type": "object"
          }
        },
        "title": "send_text_messageArguments"
      }
    },
    {
      "name": "send_chat_action",
      "description": "Broadcast ongoing bot status to the user (e.g., typing, uploading document, recording).\n\n向使用者廣播機器人當前的操作狀態，如打字中、上傳檔案中等。\n",
      "inputSchema": {
        "properties": {
          "action": {
            "default": "typing",
            "enum": [
              "typing",
              "upload_document",
              "upload_photo",
              "record_video",
